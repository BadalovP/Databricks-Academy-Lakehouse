  "existing_auto_compaction": {
    "tables": [
      "gold_station_shortage",
      "gold_rebalancing_priority"
    ],
    "detail": "Each history holds one OPTIMIZE with operationParameters auto=true on 2026-10-01 (DBR 17.3): Delta auto-compaction after MERGE folded 2 files and 1 deletion vector into 1 file. Performed by the runtime, not by a manual command."
  },
  "decisions": {
    "OPTIMIZE": {
      "executed": false,
      "reason": "Not justified. The largest table, silver_historical_trips, is 10 files / 68.5 MB (avg 6.9 MB); every station table is a single file; auto-compaction is already active. A manual OPTIMIZE would merge a handful of small files with no measurable query benefit at this size, and GP1 - the precondition set for running it - was TERMINATED, so it was not started for this."
    },
    "CHANGE_DATA_FEED": {
      "executed": false,
      "state": "not enabled on any table",
      "reason": "No downstream consumer reads row-level changes. Lakeflow reads the append-only Bronze as a stream, which does not need CDF. Enabling it would only add storage."
    },
    "DELETION_VECTORS": {
      "executed": false,
      "state": "already enabled on every table by the platform default (delta.enableDeletionVectors=true)",
      "reason": "Inspected and documented, not changed. They are what make the execution-scoped MERGE deletes cheap."
    },
    "LIQUID_CLUSTERING": {
      "executed": false,
      "state": "no clustering or partition columns on any table",
      "reason": "At 68 MB every query is a full scan anyway. The concrete future case is clustering silver_historical_trips by execution_id once many months accumulate; that is documented, not applied."
    },
    "VACUUM": {
      "executed": false,
      "reason": "Deliberately never executed. VACUUM permanently deletes files outside the retention window and removes time-travel rollback. This project's evidence includes table history (for example the Phase 2 correction versions), which it values more than a VACUUM checkbox."
    }
  }
