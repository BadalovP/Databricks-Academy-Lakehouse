{
  "datasets": [
    {
      "name": "organization_performance",
      "displayName": "Organization Performance",
      "config": {
        "dimensions": [
          {
            "expr": "organization_name",
            "name": "organization_name"
          },
          {
            "expr": "city",
            "name": "city"
          },
          {
            "expr": "state",
            "name": "state"
          }
        ],
        "measures": [
          {
            "expr": "SUM(encounter_count)",
            "name": "total_encounters"
          },
          {
            "expr": "SUM(total_claim_cost)",
            "name": "total_claim_cost"
          }
        ],
        "source": "dbr_dev.parvinbadalov.agg_organization_performance",
        "version": "1.1"
      }
    },
    {
      "name": "payer_performance",
      "displayName": "Payer Performance",
      "config": {
        "dimensions": [
          {
            "expr": "payer_name",
            "name": "payer_name"
          },
          {
            "expr": "state_headquartered",
            "name": "state_headquartered"
          }
        ],
        "measures": [
          {
            "expr": "SUM(encounter_count)",
            "name": "total_encounters"
          },
          {
            "expr": "SUM(payer_coverage)",
            "name": "total_coverage"
          },
          {
            "expr": "AVG(coverage_pct)",
            "name": "coverage_percentage"
          }
        ],
        "source": "dbr_dev.parvinbadalov.agg_payer_performance",
        "version": "1.1"
      }
    },
    {
      "name": "conditions",
      "displayName": "Top Conditions",
      "config": {
        "dimensions": [
          {
            "expr": "condition_description",
            "name": "condition_description"
          },
          {
            "expr": "condition_code",
            "name": "condition_code"
          }
        ],
        "measures": [
          {
            "expr": "SUM(unique_patients)",
            "name": "patient_count"
          },
          {
            "expr": "SUM(condition_event_count)",
            "name": "occurrence_count"
          }
        ],
        "source": "dbr_dev.parvinbadalov.agg_condition_summary",
        "version": "1.1"
      }
    },
    {
      "name": "encounters",
      "displayName": "Encounters Data",
      "config": {
        "dimensions": [
          {
            "expr": "encounter_date",
            "name": "encounter_date"
          },
          {
            "expr": "encounter_class",
            "name": "encounter_class"
          },
          {
            "expr": "patient_id",
            "name": "patient_id"
          }
        ],
        "measures": [
          {
            "expr": "COUNT(*)",
            "name": "total_encounters"
          },
          {
            "expr": "COUNT(DISTINCT patient_key)",
            "name": "unique_patients"
          },
          {
            "expr": "SUM(total_claim_cost)",
            "name": "total_claim_cost"
          },
          {
            "expr": "AVG(total_claim_cost)",
            "name": "avg_claim_cost"
          },
          {
            "expr": "COUNT(CASE WHEN LOWER(encounter_class) = 'emergency' THEN 1 END)",
            "name": "emergency_encounters"
          },
          {
            "expr": "(MEASURE(`emergency_encounters`) * 100.0) / MEASURE(`total_encounters`)",
            "name": "emergency_percentage"
          }
        ],
        "source": "dbr_dev.parvinbadalov.fact_encounters",
        "version": "1.1"
      }
    },
    {
      "name": "daily_encounters",
      "displayName": "Daily Encounters Trend",
      "config": {
        "dimensions": [
          {
            "expr": "encounter_date",
            "name": "encounter_date"
          }
        ],
        "measures": [
          {
            "expr": "SUM(encounter_count)",
            "name": "daily_encounters"
          },
          {
            "expr": "SUM(total_claim_cost)",
            "name": "daily_claim_cost"
          },
          {
            "expr": "SUM(emergency_encounters)",
            "name": "emergency_encounters"
          }
        ],
        "source": "dbr_dev.parvinbadalov.agg_daily_encounters",
        "version": "1.1"
      }
    }
  ],
