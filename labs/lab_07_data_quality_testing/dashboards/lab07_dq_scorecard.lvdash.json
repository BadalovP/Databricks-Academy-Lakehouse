{
  "datasets": [
    {
      "name": "overall_quality",
      "displayName": "Overall Quality Score",
      "queryLines": [
        "SELECT\n",
        "  dimension,\n",
        "  checks,\n",
        "  passed,\n",
        "  warnings,\n",
        "  failed,\n",
        "  score_pct,\n",
        "  run_id\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov.lab07_quality_scorecard\n",
        "WHERE\n",
        "  dimension = 'OVERALL'\n",
        "ORDER BY\n",
        "  run_id DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "quality_status_breakdown",
      "displayName": "Quality Status Breakdown",
      "queryLines": [
        "SELECT\n",
        "  quality_date,\n",
        "  dimension,\n",
        "  _dq_status,\n",
        "  count as record_count\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov.license_quality_by_dimension\n",
        "ORDER BY\n",
        "  quality_date DESC,\n",
        "  dimension,\n",
        "  _dq_status"
      ]
    },
    {
      "name": "quality_by_dimension",
      "displayName": "Quality by Dimension",
      "queryLines": [
        "WITH latest_quality_date AS (\n",
        "  SELECT\n",
        "    MAX(quality_date) AS quality_date\n",
        "  FROM\n",
        "    dbr_dev.parvinbadalov.license_quality_by_dimension\n",
        "), dimension_counts AS (\n",
        "  SELECT\n",
        "    q.dimension,\n",
        "    SUM(q.`count`) AS affected_records,\n",
        "    SUM(CASE WHEN q._dq_status = 'WARN' THEN q.`count` ELSE 0 END) AS warnings,\n",
        "    SUM(CASE WHEN q._dq_status = 'QUARANTINE' THEN q.`count` ELSE 0 END) AS failed\n",
        "  FROM\n",
        "    dbr_dev.parvinbadalov.license_quality_by_dimension q\n",
        "    INNER JOIN latest_quality_date l\n",
        "      ON q.quality_date = l.quality_date\n",
        "  GROUP BY\n",
        "    q.dimension\n",
        ")\n",
        "SELECT\n",
        "  dimension,\n",
        "  affected_records,\n",
        "  warnings,\n",
        "  failed,\n",
        "  ROUND((failed * 100.0) / NULLIF(affected_records, 0), 1) as quarantine_rate\n",
        "FROM\n",
        "  dimension_counts\n",
        "ORDER BY\n",
        "  failed DESC,\n",
        "  dimension"
      ]
    },
    {
      "name": "daily_quality_trends",
      "displayName": "Daily Quality Trends",
      "queryLines": [
        "SELECT\n",
        "  quality_date,\n",
        "  total_rows,\n",
        "  trusted_rows,\n",
        "  quarantined_rows,\n",
        "  warning_rows,\n",
        "  quality_score_pct,\n",
        "  ROUND((trusted_rows * 100.0) / NULLIF(total_rows, 0), 1) as trusted_pct,\n",
        "  ROUND((quarantined_rows * 100.0) / NULLIF(total_rows, 0), 1) as quarantined_pct,\n",
        "  ROUND((warning_rows * 100.0) / NULLIF(total_rows, 0), 1) as warning_pct,\n",
        "  latest_ingested_at,\n",
        "  latest_source_updated_at\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov.license_quality_daily\n",
        "ORDER BY\n",
        "  quality_date DESC"
      ]
    }
