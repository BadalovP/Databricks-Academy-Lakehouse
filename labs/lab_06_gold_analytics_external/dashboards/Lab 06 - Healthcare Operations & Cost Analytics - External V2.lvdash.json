    {
      "name": "top_10_conditions",
      "displayName": "Top 10 Conditions",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  condition_description,\n  SUM(condition_events) AS total_events_sum\nFROM dbr_dev.parvinbadalov_lab06_ext.agg_condition_summary GROUP BY condition_description ORDER BY SUM(condition_events) DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "condition_description",
            "expr": "condition_description"
          }
        ],
        "measures": [
          {
            "name": "condition_events",
            "expr": "SUM(total_events_sum)"
          }
        ]
      }
    },
    {
      "name": "top_10_orgs",
      "displayName": "Top 10 Organizations",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  organization_name,\n  SUM(encounter_count) AS total_encounter_count\nFROM dbr_dev.parvinbadalov_lab06_ext.agg_organization_performance GROUP BY organization_name ORDER BY SUM(encounter_count) DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "organization_name",
            "expr": "organization_name"
          }
        ],
        "measures": [
          {
            "name": "encounter_count",
            "expr": "SUM(total_encounter_count)"
          }
        ]
      }
    },
    {
      "name": "top_10_payers",
      "displayName": "Top 10 Payers",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  payer_name,\n  SUM(total_claim_cost) AS total_cost_sum\nFROM dbr_dev.parvinbadalov_lab06_ext.agg_payer_performance GROUP BY payer_name ORDER BY SUM(total_claim_cost) DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "payer_name",
            "expr": "payer_name"
          }
        ],
        "measures": [
          {
            "name": "total_claim_cost",
            "expr": "SUM(total_cost_sum)"
          }
        ]
      }
    },
    {
      "name": "d91a4696",
      "displayName": "kpi_total_patients",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT patient_key) AS total_patients\r\n",
        "FROM dbr_dev.parvinbadalov_lab06_ext.fact_encounters;"
      ]
    },
    {
      "name": "encounter_class_analysis",
      "displayName": "Encounter Class Analysis",
      "queryLines": [
        "SELECT\n",
        "  encounter_class,\n",
        "  COUNT(*) AS encounter_count,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN encounter_class = 'emergency' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS emergency_count\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov_lab06_ext.fact_encounters\n",
        "WHERE\n",
        "  (\n",
        "    :encounter_date_range.min IS NULL\n",
        "    OR encounter_date >= :encounter_date_range.min\n",
        "  )\n",
        "  AND (\n",
        "    :encounter_date_range.max IS NULL\n",
        "    OR encounter_date <= :encounter_date_range.max\n",
        "  )\n",
        "GROUP BY\n",
        "  encounter_class\n",
        "ORDER BY\n",
        "  encounter_count DESC"
      ],
      "parameters": [
        {
          "displayName": "Encounter Date Range",
          "keyword": "encounter_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "kpi_metrics",
      "displayName": "KPI Metrics",
      "queryLines": [
        "SELECT\n",
        "  AVG(duration_minutes) AS avg_duration_minutes,\n",
        "  SUM(patient_responsibility) AS total_patient_responsibility,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN encounter_class = 'emergency' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS emergency_encounters,\n",
        "  COUNT(*) AS total_encounters,\n",
        "  CAST(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN encounter_class = 'emergency' THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    ) AS DOUBLE\n",
        "  )\n",
        "    / COUNT(*) AS emergency_pct\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov_lab06_ext.fact_encounters\n",
        "WHERE\n",
        "  (\n",
        "    :encounter_date_range.min IS NULL\n",
        "    OR encounter_date >= :encounter_date_range.min\n",
        "  )\n",
        "  AND (\n",
        "    :encounter_date_range.max IS NULL\n",
        "    OR encounter_date <= :encounter_date_range.max\n",
        "  )"
      ],
      "parameters": [
        {
          "displayName": "Encounter Date Range",
          "keyword": "encounter_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "active_conditions",
      "displayName": "Active Conditions",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  condition_description,\n  SUM(active_condition_events) AS active_events_sum\nFROM dbr_dev.parvinbadalov_lab06_ext.agg_condition_summary GROUP BY condition_description ORDER BY SUM(active_condition_events) DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "condition_description",
            "expr": "condition_description"
          }
        ],
        "measures": [
          {
            "name": "active_condition_events",
            "expr": "SUM(active_events_sum)"
          }
        ]
      }
    },
    {
      "name": "payer_coverage_pct",
      "displayName": "Payer Coverage Percentage",
      "config": {
        "version": "1.1",
        "source": "dbr_dev.parvinbadalov_lab06_ext.agg_payer_performance",
        "dimensions": [
          {
            "name": "payer_name",
            "expr": "payer_name"
          },
          {
            "name": "coverage_pct",
            "expr": "coverage_pct"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)"
          }
        ]
      }
    },
    {
      "name": "org_cost_performance",
      "displayName": "Organization Cost Performance",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  organization_name,\n  SUM(total_claim_cost) AS total_claim_cost_sum,\n  SUM(unique_patients) AS unique_patients_sum,\n  AVG(avg_claim_cost) AS avg_claim_cost_avg\nFROM dbr_dev.parvinbadalov_lab06_ext.agg_organization_performance GROUP BY organization_name ORDER BY SUM(total_claim_cost) DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "organization_name",
            "expr": "organization_name"
          }
        ],
        "measures": [
          {
            "name": "total_claim_cost",
            "expr": "SUM(total_claim_cost_sum)"
          },
          {
            "name": "unique_patients",
            "expr": "SUM(unique_patients_sum)"
          },
          {
            "name": "avg_claim_cost",
            "expr": "AVG(avg_claim_cost_avg)"
          }
        ]
      }
    },
    {
      "name": "conditions_by_patients",
      "displayName": "Conditions by Unique Patients",
      "queryLines": [
        "SELECT\n",
        "  condition_description,\n",
        "  SUM(unique_patients) AS total_unique_patients\n",
        "FROM\n",
        "  dbr_dev.parvinbadalov_lab06_ext.agg_condition_summary\n",
        "GROUP BY\n",
        "  condition_description\n",
        "ORDER BY\n",
        "  SUM(unique_patients) DESC\n",
        "LIMIT 10"
      ]
    }
  ],
